{
  "version": "0.2.2",
  "description": "A desktop workbench for running Claude in an isolated virtual machine",
  "homepage": "https://github.com/Lee-xeo/Claude-Cage",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/Lee-xeo/Claude-Cage/releases/download/v0.2.2/Cage-0.2.2-windows-amd64-setup.exe",
      "hash": "9a767ce6e8d020257c3c53bf149de2a613dc0327601a5920859e43d15c1a54ff"
    }
  },
  "installer": {
    "args": [
      "/S",
      "/D=$dir\\app"
    ]
  },
  "uninstaller": {
    "script": [
      "$target = Join-Path $dir 'app'",
      "$runner = Join-Path $dir 'uninstall-cage.exe'",
      "Copy-Item -LiteralPath \"$target\\Uninstall.exe\" -Destination $runner -Force",
      "$process = Start-Process -FilePath $runner -ArgumentList \"/S _?=$target\" -Wait -PassThru",
      "if ($process.ExitCode -ne 0) { throw \"Cage uninstall failed with exit code $($process.ExitCode)\" }"
    ]
  },
  "checkver": {
    "github": "https://github.com/Lee-xeo/Claude-Cage"
  }
}
